#!/usr/bin/env bash
# fork-flow commit-msg: the Fork-Flow-Change trailer gate, then the project's own commit-msg.
#
# Every commit names its ledger entry in a Fork-Flow-Change: trailer. Exempt: wip: (or wip(…)) subjects, a
# merge in progress (MERGE_HEAD) and, on a port/* branch, everything but a custom(...) subject (the port's
# adapt commits, which retirement and honest.sh find by their trailer). A port: subject is exempt only on
# a port/* branch and needs FORK_FLOW_PORT=1 there. pre-commit refuses the port commit without it first
# (MERGE_HEAD, REVERT_HEAD, or no port commit on the branch yet); this check is the second net for a
# port: subject.
msg=$1
subject=$(grep -v '^#' "$msg" | grep -v '^[[:space:]]*$' | sed -n 1p || true)
branch=$(git symbolic-ref -q --short HEAD || true)

gate() {
  case "$branch" in
  port/*)
    case "$subject" in
    port:*)
      if [ "${FORK_FLOW_PORT:-}" != 1 ]; then
        echo "commit-msg: a port: commit on $branch needs FORK_FLOW_PORT=1" >&2
        return 1
      fi
      return 0
      ;;
    custom\(*) ;;
    *) return 0 ;;
    esac
    ;;
  esac

  case "$subject" in
  wip:* | wip\(*) return 0 ;;
  esac
  git rev-parse -q --verify MERGE_HEAD >/dev/null && return 0

  if ! grep -v '^#' "$msg" | git interpret-trailers --parse | grep -q '^Fork-Flow-Change: [^[:space:]]'; then
    echo "commit-msg: the message has no Fork-Flow-Change: trailer (wip: subjects and merges are exempt)." >&2
    echo "  End it with a last paragraph of trailer lines: Fork-Flow-Change: <ledger slug> per touched .fork/CHANGES.md" >&2
    echo "  entry; no entry touched → Fork-Flow-Change: superflow-workflow (kit folders only) or Fork-Flow-Change: none" >&2
    echo "  (fork-change step 8). A trailer inside the body, not in the last paragraph, is not parsed." >&2
    return 1
  fi
}
gate || exit 1

# The hooks dir that was in use before, recorded by ./.fork/setup.sh.
exec "$(dirname "$0")/_chain" commit-msg "$@"
