#!/usr/bin/env bash
# fork-flow pre-merge-commit: the ledger gate, then the project's own pre-merge-commit.
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# fork-flow: the ledger gate for a merge that completes without conflicts (git runs this hook only
# then; a conflicted merge finished with `git commit` goes through pre-commit instead).
if [ ! -x .fork/check.sh ]; then
  echo "pre-merge-commit: .fork/check.sh is missing or not executable; the ledger gate cannot run" >&2
  exit 1
fi
.fork/check.sh || exit 1

# fork-flow: skip the project's own hook for upstream merges on a port branch (see pre-commit).
[ "${FORK_FLOW_PORT:-}" = 1 ] && exit 0

exec .fork/hooks/_chain pre-merge-commit "$@"
